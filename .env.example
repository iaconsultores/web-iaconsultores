# Variables de entorno de la web (solo los nombres; los valores nunca se versionan).
# En Hostinger: hPanel → Sitios web → iaconsultores.com → Node.js → Variables de entorno.
# En local no hacen falta: `npm run local` simula Claude y el email.

# Obligatorias en producción
ANTHROPIC_API_KEY=
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Opcionales: aviso de cada lead a n8n, firmado con HMAC-SHA256
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Solo en local y en pruebas: respuestas simuladas, sin red (valor 1)
CLAUDE_SIMULADO=
RESEND_SIMULADO=
