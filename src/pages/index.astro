---
import Base from "../layouts/Base.astro";
import Portada from "../components/portada/Portada.astro";
import Panel from "../components/panel/Panel.astro";
import Servicios from "../components/servicios/Servicios.astro";
import Flujos from "../components/flujos/Flujos.astro";
import Contenido from "../components/contenido/Contenido.astro";
import Chat from "../components/chat/Chat.astro";
import ZonasPortada from "../components/zonas/ZonasPortada.astro";
import { DATOS_EMPRESA } from "../lib/paginas-locales";
---
<Base titulo="IA y automatización para empresas en Alicante | IA Consultores" descripcion="Consultoría de IA y automatización para pymes de Alicante y su provincia. Primero entendemos tu negocio: llamada gratuita de 30 minutos y visita a tu empresa." ruta="/">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "IA Consultores",
    url: "https://iaconsultores.com",
    description: "Consultoría de inteligencia artificial y automatización para pymes y autónomos de la provincia de Alicante: en persona en la provincia y alrededores, en remoto en el resto de España.",
    ...DATOS_EMPRESA,
    areaServed: [
      { "@type": "AdministrativeArea", name: "Provincia de Alicante" },
      { "@type": "AdministrativeArea", name: "Provincia de Valencia" },
      { "@type": "AdministrativeArea", name: "Región de Murcia" },
      { "@type": "AdministrativeArea", name: "Provincia de Albacete" },
      { "@type": "Country", name: "España" },
    ],
  })} />
  <Portada />
  <Panel />
  <Servicios />
  <Flujos />
  <ZonasPortada />
  <Contenido />
  <Chat slot="final" />
</Base>
