---
/* Tarjeta de un artículo de soluciones para los listados */
import { rutaSolucion } from "../../datos/soluciones";

interface Props {
  slug: string;
  titulo: string;
  resumen: string;
  sector: string;
  /** Nivel del título de la tarjeta: h3 en listados con h2 por encima */
  nivel?: "h2" | "h3";
  /** Enlace de la tarjeta (por defecto, el artículo de /soluciones) */
  href?: string;
  /** Texto del pie de la tarjeta */
  mas?: string;
}

const { slug, titulo, resumen, sector, nivel = "h3", href = rutaSolucion(slug), mas = "Leer la solución →" } = Astro.props;
const Titulo = nivel;
---
<article class="tarjeta-sol">
  <p class="tarjeta-sol-sector">{sector}</p>
  <Titulo class="tarjeta-sol-titulo"><a href={href}>{titulo}</a></Titulo>
  <p class="tarjeta-sol-resumen">{resumen}</p>
  <span class="tarjeta-sol-mas" aria-hidden="true">{mas}</span>
</article>
