# Copia este archivo como .env (no se versiona). README.md explica cada valor.
# Clave con la que n8n cifra las credenciales guardadas (cualquier texto largo y aleatorio; no la cambies después)
N8N_ENCRYPTION_KEY=
# El mismo valor que N8N_WEBHOOK_SECRET en las variables de entorno de la web (hPanel)
IAC_WEBHOOK_SECRET=
